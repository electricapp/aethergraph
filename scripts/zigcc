#!/bin/sh
# zig as the C compiler and linker for cross-building the Linux-only
# surface off-Linux (scripts/check-linux.sh). ZIG_TARGET picks the zig
# triple; defaults to x86_64.
#
# cc-rs passes the Rust triple through as `-target`, which zig does not parse.
# Strip any caller-supplied target so the one below is the only one.
args=""
skip=0
for a in "$@"; do
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case "$a" in
    -target) skip=1; continue ;;
    --target=*) continue ;;
  esac
  args="$args $a"
done
exec zig cc -target "${ZIG_TARGET:-x86_64-linux-gnu}" $args
